// Adds the two unary numbers on the tape. Numbers are n+1 marks; input
// "a gap b" with the head on a's first mark; output one section a+b.
use std::goToEnd, std::goToBegin;

main() {
    @goToEnd();
    right;
    right;
    @goToEnd();
    unmark;
    left;
    @goToBegin();
    left;
    mark;
    @goToEnd();
    unmark;
    left;
    @goToBegin(!);
}
