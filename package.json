    "svelte-codemirror-editor": "^2.1.0"
  },
  "devDependencies": {
    "@codemirror/lint": "^6.9.7",
    "@mermaid-js/layout-elk": "^0.2.2",
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
