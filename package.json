{
  "name": "machines-demo",
  "private": true,
  "version": "1.0.0-alpha.29",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "postinstall": "node scripts/fetch-toolchains-wasm.mjs",
    "fetch:wasm": "node scripts/fetch-toolchains-wasm.mjs",
    "test:scripts": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@lezer/highlight": "^1.2.5",
    "@post-machine-js/machine": "^7.1.0",
    "@tabler/icons": "^3.52.0",
    "@turing-machine-js/machine": "^7.1.0",
    "@turing-machine-js/visuals": "^7.1.0",
    "codemirror": "^6.0.2",
    "svelte-codemirror-editor": "^2.1.0"
  },
  "devDependencies": {
    "@codemirror/lint": "^6.9.8",
    "@mermaid-js/layout-elk": "^1.0.2",
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "happy-dom": "^21.0.4",
    "mermaid": "^12.3.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.11.0",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
